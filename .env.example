# Copiar a .env y completar. NUNCA versionar .env (regla 7).
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://abaya:CAMBIAR@localhost:5432/abaya_rpa?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Clave AES-256-GCM en base64 (32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Rotación: id de la clave actual y claves anteriores (id:base64,...) solo para descifrar
FIELD_ENCRYPTION_KEY_ID=1
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# Puertos HTTP
API_PORT=3000
RPA_PORT=3001

# Abaya (se completan en F1/F2, desde el gestor de secretos)
ABAYA_BASE_URL=
ABAYA_USER=
ABAYA_PASSWORD=
# MFA del usuario robot: none | totp (secreto base32 desde el gestor de secretos)
ABAYA_MFA_MODE=none
ABAYA_TOTP_SECRET=
ABAYA_HEADLESS=true
# storageState cifrado (fuera de git)
SESSION_STATE_DIR=.secrets
HEARTBEAT_INTERVAL_MS=30000

# LLM (F5)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Operación (F7)
ALERT_WEBHOOK_URL=
INACTIVITY_MINUTES=120
# Token del panel de administración (generar uno largo y aleatorio)
ADMIN_TOKEN=
