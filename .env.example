# Copiar a .env y completar. NUNCA versionar .env (regla 7).
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://abaya:CAMBIAR@localhost:5432/abaya_rpa?schema=public

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Clave AES-256-GCM en base64 (32 bytes). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# Rotación: id de la clave actual y claves anteriores (id:base64,...) solo para descifrar
FIELD_ENCRYPTION_KEY_ID=1
FIELD_ENCRYPTION_PREVIOUS_KEYS=

# Puertos HTTP
API_PORT=3000
RPA_PORT=3001

# Abaya = ySocial, consola del asesor (docs/abaya-mapa-pantallas.md). Se completan desde el
# gestor de secretos; el robot necesita su propio usuario de asesor. Ej.: https://<tenant>.ysocial.net/agent/
ABAYA_BASE_URL=
ABAYA_USER=
ABAYA_PASSWORD=
# MFA del usuario robot: none | totp (secreto base32 desde el gestor de secretos)
ABAYA_MFA_MODE=none
ABAYA_TOTP_SECRET=
ABAYA_HEADLESS=true
# storageState cifrado (fuera de git)
SESSION_STATE_DIR=.secrets
HEARTBEAT_INTERVAL_MS=30000

# LLM (F5): anthropic | openai | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini (D-006): clave de Google AI Studio de un proyecto CON facturación (en el nivel gratuito
# Google puede usar los datos enviados). Sirve para el modelo y para EMBEDDINGS_PROVIDER=gemini.
GEMINI_API_KEY=
# Modelo (v1.5): timeout por llamada (1 reintento) y proveedor de respaldo opcional. Es la espera
# a la API del modelo, no al cliente. D-009: si el modelo no responde, se pausan los robots.
LLM_TIMEOUT_MS=15000
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
# Notas de voz (D-010): voz a texto. Vacío = gemini si hay GEMINI_API_KEY (simulado con
# LLM_PROVIDER=simulado; si no, ninguno: se le pide al cliente que escriba).
STT_PROVIDER=
STT_MODEL=
STT_TIMEOUT_MS=10000
STT_MAX_SECONDS=120
# Imágenes de planes (D-011): se leen con Gemini (requiere GEMINI_API_KEY). El robot todavía no
# las envía en Abaya (fase 3); por ahora solo «Probar agente» las muestra.
IMAGE_READER_MODEL=
# Vista «Consumo»: tarifa en USD por millón de tokens, para el costo ESTIMADO. Copiarla de la página
# de precios del proveedor. Vacío = solo tokens. Formato: {"<modelo>":{"input":<USD>,"output":<USD>}}
MODEL_PRICES_USD=
# Configuración del agente en el panel (v1.8): modelos elegibles del proveedor principal,
# separados por coma (vacío = solo LLM_MODEL).
LLM_MODEL=
LLM_ALLOWED_MODELS=

# Operación (F7)
ALERT_WEBHOOK_URL=
INACTIVITY_MINUTES=120
# D-009: cliente esperando respuesta → «dame un momento» a los HOLD_AFTER_SECONDS, luego uno cada
# HOLD_EVERY_SECONDS, hasta HOLD_MAX por ráfaga (y se vuelve a programar el turno).
HOLD_AFTER_SECONDS=120
HOLD_EVERY_SECONDS=180
HOLD_MAX=5
# D-014 fase 2: ofrecer con las imágenes del catálogo en las conversaciones reales (el robot las
# pega en Abaya). false hasta probarlo en vivo.
SEND_PLAN_IMAGES=false
# Trazabilidad (D-002): días que se conserva el contenido de las conversaciones cerradas
# (mensajes, perfil, resumen y respuesta del consentimiento). Vacío = no se borra. Lo define Claro.
CONVERSATION_RETENTION_DAYS=
# Capacidad por robot (v1.5): tope de chats simultáneos y alerta de respuesta lenta (p95, 15 min).
MAX_CHATS_PER_ROBOT=3
RESPONSE_P95_ALERT_MS=20000
# Reciclaje del navegador del robot (horas; 0 = nunca). Solo con la bandeja vacía.
BROWSER_RECYCLE_HOURS=6
# Horario inicial de los robots, hora de Colombia (vacío = siempre); después se cambia en el panel
# (Robots → Horario). Fuera de él no abren Abaya; al terminar pasan a FinTurno, terminan sus chats
# y hacen «Salir» (D-026, runbook 12.6).
ROBOT_WORK_HOURS=
# Panel de administración: usuarios con contraseña (ver docs/runbook.md, "Usuarios del panel").
# El primer ADMIN se crea por consola: pnpm --filter @abaya/api create-admin -- <usuario>
# Cookie de sesión solo por HTTPS; "false" solo para desarrollo por HTTP fuera de localhost.
ADMIN_COOKIE_SECURE=true

# Vida del token de acceso de los robots hijos (ms). Por defecto 1 h; bajarlo solo para pruebas.
ROBOT_ACCESS_TTL_MS=3600000
# Clave pública de publicación de los robots (v1.7; por defecto apps/rpa/release-key.pub).
ROBOT_RELEASE_PUBLIC_KEY=
# Instalador que ofrece el panel (por defecto dist/robot-package/abaya-robot-windows.zip).
ROBOT_PACKAGE_FILE=
# Nombre del equipo de este robot (por defecto, el nombre de la máquina).
ROBOT_HOST=

# ---------- Brains (v1.9) ----------
# Embeddings de la búsqueda: none (solo texto completo en español) | openai | voyage | gemini
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_MODEL=
VOYAGE_API_KEY=
# Contexto completo: máximo de tokens por fuente; búsqueda: fragmentos por turno; tamaño de archivo
KNOWLEDGE_FULL_CONTEXT_MAX_TOKENS=2000
KNOWLEDGE_SEARCH_TOP_K=4
KNOWLEDGE_MAX_FILE_MB=10
