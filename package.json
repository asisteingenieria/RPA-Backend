{
  "name": "abaya-rpa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @abaya/db run generate",
    "db:migrate": "pnpm --filter @abaya/db run migrate:dev",
    "evals": "pnpm --filter @abaya/evals start",
    "demo": "node scripts/demo.mjs",
    "demo:abaya": "pnpm --filter @abaya/rpa exec tsx test/mock-abaya/serve.ts",
    "robot:package": "node scripts/build-robot-package.mjs",
    "loadtest": "pnpm --filter @abaya/rpa exec tsx test/loadtest/loadtest.ts",
    "robot:keys": "node scripts/robot-release-keys.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
