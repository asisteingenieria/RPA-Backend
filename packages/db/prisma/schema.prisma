// Modelo de datos — sección 5 de docs/planRPA.md

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum ConversationStatus {
  ACTIVE
  WAITING_CONSENT
  TRANSFERRING
  TRANSFERRED_BACKOFFICE
  CLOSED_NO_SALE
  CLOSED_SUPPORT
  CLOSED_INACTIVE
  NEEDS_REVIEW // algo quedó incierto: requiere humano
}

model Conversation {
  id               String             @id @default(cuid())
  abayaChatId      String             @unique
  stage            String             @default("MENU") // estado de la máquina
  profileEncrypted Bytes? // datos extraídos (nombre, operador, uso)
  robotUser        String
  status           ConversationStatus @default(ACTIVE)
  customerRefHash  String? // hash del identificador del cliente
  lastInboundAt    DateTime?
  lastOutboundAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  messages         Message[]
  sale             Sale?
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum OutboundStatus {
  PENDING
  SENDING
  SENT_VERIFIED
  UNCERTAIN // no verificado: NUNCA se reintenta automáticamente
  FAILED
}

model Message {
  id             String          @id @default(cuid())
  conversationId String
  direction      Direction
  fingerprint    String?         @unique // entrantes: deduplicación
  idempotencyKey String?         @unique // salientes
  bodyEncrypted  Bytes
  status         OutboundStatus?
  detectedVia    String? // "network" | "dom"
  attempts       Int             @default(0)
  processedAt    DateTime? // entrantes: turno del motor que ya los atendió
  /// salientes (v1.5): primera respuesta de un turno → cuándo el robot detectó el primer
  /// mensaje de la ráfaga; y cuándo Abaya confirmó el envío. Ambas con el reloj del robot.
  respondsToAt   DateTime?
  sentAt         DateTime?
  occurredAt     DateTime
  createdAt      DateTime        @default(now())
  conversation   Conversation    @relation(fields: [conversationId], references: [id])

  @@index([conversationId, occurredAt])
  @@index([sentAt])
}

model Sale {
  id               String       @id @default(cuid())
  conversationId   String       @unique
  process          String // tipo de venta (portabilidad, migración, línea nueva)
  planCode         String
  summaryEncrypted Bytes // resumen estructurado para el backoffice
  transferredAt    DateTime?
  backofficeNoteOk Boolean      @default(false)
  createdAt        DateTime     @default(now())
  conversation     Conversation @relation(fields: [conversationId], references: [id])
}

model ConsentEvidence {
  // append-only con cadena de hashes
  id                     String   @id @default(cuid())
  /// Orden real de inserción: la punta de la cadena es el seq más alto.
  seq                    Int      @unique @default(autoincrement())
  conversationId         String
  textShownHash          String // hash del texto de autorización mostrado
  /// Versión de la plantilla legal mostrada (permite reconstruir el texto y su hash).
  templateVersion        String
  customerReplyEncrypted Bytes
  acceptedAt             DateTime // hora de Bogotá
  /// Único: la cadena no puede bifurcarse.
  prevHash               String   @unique
  hash                   String   @unique

  @@index([conversationId])
}

model RpaSession {
  id               String    @id @default(cuid())
  robotUser        String    @unique
  status           String // ACTIVE | RELOGGING | DOWN | PAUSED
  lastHeartbeat    DateTime
  lastLoginAt      DateTime?
  consecutiveFails Int       @default(0)
}

model RpaActionLog {
  // auditoría inmutable con cadena de hashes (una cadena por usuario robot)
  id          String   @id @default(cuid())
  seq         Int      @unique @default(autoincrement())
  robotUser   String
  action      String // LOGIN, OPEN_CHAT, SEND, NOTE, TRANSFER, CLOSE
  abayaChatId String?
  result      String // OK | ERROR | UNCERTAIN
  durationMs  Int
  traceRef    String?
  prevHash    String
  hash        String   @unique
  createdAt   DateTime @default(now())

  /// La cadena de cada robot no puede bifurcarse.
  @@unique([robotUser, prevHash])
  @@index([robotUser, createdAt])
}

model Plan {
  // catálogo: ÚNICA fuente de planes y precios
  code         String    @id // p. ej. M1, L2, P1
  process      String // PORTABILIDAD | MIGRACION | LINEA_NUEVA
  name         String
  dataGb       Int
  priceCop     Int
  discountText String? // texto aprobado por Claro, no generado
  benefits     String[]
  active       Boolean   @default(true)
  validFrom    DateTime
  validTo      DateTime?
}

model PromptVersion {
  // prompts v1 por estado; histórico desde v1.8 (ver AgentConfigVersion)
  id         String   @id @default(cuid())
  stage      String
  version    Int
  content    String
  approvedBy String?
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([stage, version])
}

enum AgentConfigStatus {
  DRAFT
  EVALUATING
  PUBLISHED
  ARCHIVED
  REJECTED
}

model AgentConfigVersion {
  // configuración y guion del agente editados en el panel (v1.8, sección 6.3.8).
  // Una sola PUBLISHED a la vez (transacción Serializable al publicar).
  id          String            @id @default(cuid())
  version     Int               @unique
  status      AgentConfigStatus @default(DRAFT)
  agentName   String
  companyName String
  companyInfo String
  welcome     String // saludo antes del menú A–D (fijo en código)
  prompt      String // bloque grande en Markdown
  model       String? // null = el de la configuración del worker
  temperature Float // 0–0.3
  evalSummary Json? // resultado de la suite al publicar
  createdBy   String
  publishedBy String?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
}

model LlmCall {
  // trazabilidad de cada llamada al modelo
  id               String   @id @default(cuid())
  conversationId   String
  stage            String
  provider         String
  model            String
  promptVersionId  String
  latencyMs        Int
  inputTokens      Int
  outputTokens     Int
  validationResult String // OK | REGENERATED | FALLBACK
  createdAt        DateTime @default(now())

  @@index([conversationId])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
}

model AdminAuditLog {
  // acciones hechas desde el panel / API de administración (F7)
  id        String   @id @default(cuid())
  actor     String
  action    String // KILL_SWITCH_ON | KILL_SWITCH_OFF | SESSION_RESET | ...
  target    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum AdminRole {
  ADMIN
  OPERADOR
}

model AdminUser {
  // usuarios del panel de administración (v1.3, sección 8)
  id                 String         @id @default(cuid())
  username           String         @unique
  passwordHash       String // scrypt con sal; nunca la contraseña
  role               AdminRole
  active             Boolean        @default(true)
  mustChangePassword Boolean        @default(true)
  failedAttempts     Int            @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           AdminSession[]
}

model AdminSession {
  // sesión del panel en el servidor; el token solo viaja en una cookie httpOnly
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime
  createdAt  DateTime  @default(now())
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Robot {
  // registro de robots hijos (v1.4, sección 2.6): un usuario de Abaya = un equipo a la vez
  robotUser              String    @id
  enabled                Boolean   @default(true)
  paused                 Boolean   @default(false)
  abayaPasswordEncrypted Bytes? // cifrada; nunca se devuelve al panel
  mfaMode                String    @default("none")
  totpSecretEncrypted    Bytes?
  enrollmentCodeHash     String?   @unique // código de instalación de un solo uso
  enrollmentExpiresAt    DateTime?
  agentTokenHash         String?   @unique // token de renovación vigente del equipo (hash)
  /// v1.6: token de renovación anterior (rotación) y cuándo se rotó; versión que invalida
  /// todos los tokens de acceso emitidos al subirla (deshabilitar, reinstalar, robo).
  previousTokenHash      String?   @unique
  tokenRotatedAt         DateTime?
  tokenVersion           Int       @default(0)
  enrolledAt             DateTime?
  host                   String? // nombre del equipo
  instanceId             String? // instancia en línea (evita duplicados)
  version                String?
  state                  String    @default("STOPPED") // ONLINE | STOPPED
  startedAt              DateTime?
  lastSeenAt             DateTime?
  stoppedAt              DateTime?
  lastRejectedHost       String?
  lastRejectedAt         DateTime?
  /// v1.7: actualización pedida desde el panel y lo que reportó el robot.
  updateRequested        Boolean   @default(false)
  updateStatus           String? // PENDING | WAITING_IDLE | DOWNLOADING | STAGED | APPLIED | FAILED | ROLLED_BACK
  updateVersion          String?
  updateMessage          String?
  updateAt               DateTime?
  createdBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
