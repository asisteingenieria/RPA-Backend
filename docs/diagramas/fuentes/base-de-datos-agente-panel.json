  "cards": [
    {
      "dot": "emerald",
      "title": "Versiones del agente",
      "items": [
        "AgentConfigVersion: guion, plantillas y flujo; solo una PUBLISHED la usa el motor",
        "Publicar pasa por la suite de evaluación (evalSummary, evalVerdict)"
      ]
    },
    {
      "dot": "amber",
      "title": "Referencias sin llave foránea",
      "items": [
        "LlmCall.conversationId → Conversation (diagrama 1)",
        "AgentTestRecord.versionId → AgentConfigVersion",
        "AgentBrain.agentKey conecta el agente con los Brains (diagrama 3)"
      ]
    },
    {
      "dot": "rose",
      "title": "Seguridad del panel",
      "items": [
        "AdminUser guarda solo el hash de la contraseña",
        "AdminSession guarda el hash del token de la cookie",
        "AdminAuditLog registra cada acción de los usuarios"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cómo leer las tablas",
      "items": [
        "PK llave primaria · FK llave foránea · UK valor único",
        "Tipo con «?»: admite nulo; «[]»: lista",
        "Tipos con mayúscula inicial son enumeraciones"
      ]
    }
  ]
