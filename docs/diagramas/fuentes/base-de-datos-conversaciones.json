  "cards": [
    {
      "dot": "violet",
      "title": "Datos cifrados",
      "items": [
        "Columnas *Encrypted (bytea): texto del cliente, perfil, resúmenes, audio, contraseña de Abaya y secreto MFA",
        "Se cifran en la aplicación (FieldCipher) antes de guardarse"
      ]
    },
    {
      "dot": "rose",
      "title": "Cadenas de hashes",
      "items": [
        "ConsentEvidence: cada «SÍ AUTORIZO» enlaza con el anterior (prevHash → hash)",
        "RpaActionLog: cada acción del robot, encadenada por robot"
      ]
    },
    {
      "dot": "amber",
      "title": "Referencias sin llave foránea",
      "items": [
        "robotUser enlaza Conversation, RpaSession y RpaActionLog con Robot",
        "ConsentEvidence.conversationId → Conversation",
        "Conversation.agentVersionId → AgentConfigVersion (diagrama 2)",
        "Message.imageId → VersionImage (diagrama 3)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cómo leer las tablas",
      "items": [
        "PK llave primaria · FK llave foránea · UK valor único",
        "Tipo con «?»: admite nulo; «[]»: lista",
        "Tipos con mayúscula inicial son enumeraciones"
      ]
    }
  ]
