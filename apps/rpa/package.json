{
  "name": "@abaya/rpa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run --passWithNoTests && playwright test",
    "test:unit": "vitest run --passWithNoTests",
    "test:pw": "playwright test"
  },
  "dependencies": {
    "@abaya/config": "workspace:*",
    "@abaya/crypto": "workspace:*",
    "@abaya/db": "workspace:*",
    "@abaya/domain": "workspace:*",
    "@abaya/logger": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "playwright": "1.63.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/ws": "^8.18.2",
    "ws": "^8.22.0"
  }
}
